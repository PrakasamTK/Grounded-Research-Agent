# Groq API (open-weights LLM inference)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Hacker News (Algolia Search API) needs no credentials — nothing to set here.
# Kept as a placeholder section in case you swap in a different social source later.

# LangSmith observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=grounded-research-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
